{
	"name": "independent-apps-workspace",
	"private": true,
	"packageManager": "pnpm@9.15.9",
	"scripts": {
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"test:boundaries": "node --test scripts/*.test.mjs",
		"lint": "pnpm check:boundaries && pnpm test:boundaries && biome check .",
		"build": "pnpm -r --if-present build",
		"test:e2e": "pnpm -r --if-present test:e2e",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4"
	}
}
